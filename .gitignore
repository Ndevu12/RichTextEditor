!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# testing
/coverage

# next.js
.next/
**/.next/
/out/
**/out/

# production
/build

# Build output
dist/
*/dist/

# Storybook
/storybook-static

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

