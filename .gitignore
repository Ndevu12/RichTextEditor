# dependencies
/node_modules
/.pnp
.pnp.js

# Playground / example app dependencies & lockfiles
playground/node_modules
playground/yarn.lock
playground/.yarn
examples/*/node_modules
examples/*/yarn.lock

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
